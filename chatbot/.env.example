# Copy to chatbot/.env (git-ignored) or export these in your shell.

# --- LLM ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
# "fake" = offline demo mode (only the verified example questions); default "anthropic"
LLM_PROVIDER=anthropic

# --- Database (MariaDB on the Raspberry Pi) ------------------------------
DB_HOST=192.168.1.2
DB_PORT=3306
DB_NAME=secim
# read-only user created by sql/readonly_user.sql
DB_USER=secim_okur
DB_PASSWORD=

# --- Safety limits -----------------------------------------------------
CHATBOT_MAX_ROWS=200
CHATBOT_TIMEOUT_S=10
CHATBOT_MAX_ATTEMPTS=2
