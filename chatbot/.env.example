# Copy to chatbot/.env (git-ignored) or export these in your shell.

# --- LLM ---------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
# anthropic (alias claude) | ollama (local model) | fake (offline demo: only the verified example questions)
LLM_PROVIDER=anthropic

# --- Routing -------------------------------------------------------------
# llm (default) | template (no LLM at all) | hybrid (template first, LLM fallback)
CHATBOT_MODE=llm

# --- Local model via Ollama (LLM_PROVIDER=ollama) --------------------------
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://localhost:11434
OLLAMA_TEMPERATURE=0
OLLAMA_TIMEOUT=120
# context window; Ollama's default (2-4k) truncates the prompt
OLLAMA_NUM_CTX=8192
# model = the local model also writes the answer sentence; sablon = deterministic sentence (faster)
OLLAMA_ANSWER=model
# retrieved few-shot examples per question (dev split only)
FEWSHOT_K=4

# --- Database (MariaDB on the Raspberry Pi) ------------------------------
DB_HOST=192.168.1.2
DB_PORT=3306
DB_NAME=secim
# read-only user created by sql/readonly_user.sql
DB_USER=secim_okur
DB_PASSWORD=

# --- Safety limits -----------------------------------------------------
CHATBOT_MAX_ROWS=200
CHATBOT_TIMEOUT_S=10
CHATBOT_MAX_ATTEMPTS=2
