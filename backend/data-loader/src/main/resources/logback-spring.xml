<?xml version="1.0" encoding="UTF-8"?>
<!-- Konsol + dosya. Tutarlılık bulguları ayrıca logs/tutarlilik.log'a yazılır. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
    <property name="LOG_DIZINI" value="${LOG_DIZINI:-logs}"/>

    <appender name="DOSYA" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIZINI}/data-loader.log</file>
        <append>false</append>
        <encoder><pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{30} - %msg%n</pattern><charset>UTF-8</charset></encoder>
    </appender>
    <appender name="TUTARLILIK" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_DIZINI}/tutarlilik.log</file>
        <append>false</append>
        <encoder><pattern>%-5level %msg%n</pattern><charset>UTF-8</charset></encoder>
    </appender>

    <logger name="tutarlilik" level="INFO" additivity="false">
        <appender-ref ref="TUTARLILIK"/>
    </logger>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="DOSYA"/>
    </root>
</configuration>
