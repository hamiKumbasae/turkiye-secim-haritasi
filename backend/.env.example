# Kopyalayın: cp .env.example .env  — sonra şifreleri değiştirin. .env depoya girmez (.gitignore).

# MySQL kök şifresi (yalnız ilk kurulumda kullanılır)
MYSQL_ROOT_PASSWORD=degistir-kok-sifresi

# Veritabanı ve yükleme kullanıcısı (data-loader: şema + yazma)
DB_NAME=secimler
DB_USER=secim_yukleme
DB_PASSWORD=degistir-yukleme-sifresi

# Salt okunur kullanıcı (election-api: yalnız SELECT yetkisi)
DB_READ_USER=secim_okuma
DB_READ_PASSWORD=degistir-okuma-sifresi

# Dışarıya açılan tek port (gateway)
GATEWAY_PORT=8080

# API'yi tarayıcıdan çağırabilecek siteler (virgülle)
IZINLI_KOKENLER=https://hamikumbasae.github.io
